# feature-custom-kernel-config
CONFIG_LOCALVERSION="-moon"
CONFIG_LOCALVERSION_AUTO=y

# xiaomi feature config:
CONFIG_MILLET=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"
CONFIG_DEVFREQ_QCOM_ADRENO_TZ_OPT=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_VIDEO_ADV_DEBUG=n
CONFIG_IRQ_TIME_ACCOUNTING=n
CONFIG_CPUFREQ_SCHEDUTIL_OPT=y
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_EROFS_FS=y

# set zram to lz4 helper
CONFIG_CRYPTO_LZ4=y

# set HyperOS 3.0 config:
CONFIG_XIAOMI_METIS=y
CONFIG_ZRAM_WRITEBACK_OPT=y
CONFIG_SCHED_FOC_OPT=y

# android 16-eBPF config:
CONFIG_BPF_LSM=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_PRELOAD=y
CONFIG_XDP_SOCKETS=y

# set moon change config:
CONFIG_RCU_BOOST=y
CONFIG_MOON_MEMCG_RECLAIM=y
CONFIG_MOON_BOOST_DELAYs=500
CONFIG_SOFTWARE_OS3=y

# set new_moon_changes:
CONFIG_MOON_UFS_WRITEBOOST=y
CONFIG_MOON_BINDER_TASK_BOOST=y
CONFIG_MOON_BLOCK_OWNER_OPT=y
